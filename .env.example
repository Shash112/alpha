# ==========================================
# ALPHA SAAS - MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your local or production setup.
# ==========================================

# ------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ------------------------------------------
# 2. NEXT.JS PUBLIC ENVIRONMENT VARIABLES (CLIENT-SIDE)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_publishable_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_id

# ------------------------------------------
# 3. DATABASE (POSTGRESQL)
# ------------------------------------------
DATABASE_URL=postgresql://alphaadmin:alphapassword@localhost:5432/alphadb?sslmode=disable

# ------------------------------------------
# 4. CACHE & QUEUE (REDIS)
# ------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# 5. AUTHENTICATION & JWT SECRETS
# ------------------------------------------
# Secret keys must be at least 32 characters in production
JWT_SECRET=alpha_jwt_secret_super_secure_key_min_32_bytes_long
JWT_REFRESH_SECRET=alpha_jwt_refresh_secret_super_secure_key_min_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# 6. OBJECT STORAGE (AWS S3 / S3-COMPATIBLE)
# ------------------------------------------
S3_BUCKET_NAME=alpha-dev-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key

# ------------------------------------------
# 7. BILLING & PAYMENTS - STRIPE (GLOBAL PRIMARY)
# ------------------------------------------
STRIPE_SECRET_KEY=sk_test_mock_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_mock_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_secret

# Optional Stripe Price ID Mappings
STRIPE_PRICE_ID_PRO_USD=price_mock_pro_usd
STRIPE_PRICE_ID_PRO_EUR=price_mock_pro_eur
STRIPE_PRICE_ID_TEAM_USD=price_mock_team_usd
STRIPE_PRICE_ID_BUSINESS_USD=price_mock_business_usd

# ------------------------------------------
# 8. BILLING & PAYMENTS - RAZORPAY (INDIA REGIONAL)
# ------------------------------------------
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_mock_razorpay_secret

# ------------------------------------------
# 9. NOTIFICATIONS & SMTP (EMAIL)
# ------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@alpha.com
